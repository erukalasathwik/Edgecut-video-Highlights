# Server
PORT=8787

# AssemblyAI (free tier: https://www.assemblyai.com/dashboard/signup)
# Used for word-level timestamped transcription + built-in sentiment analysis
ASSEMBLYAI_API_KEY=36f9906a30e9476387ff7836c0a07ae7cd

# SQLite file location (relative to backend/)
DB_PATH=./data/highlights.db

# Path to ffmpeg binary. Leave as "ffmpeg" if it's on your PATH.
# ffmpeg is required for audio-energy analysis (loudness/volume signal)
# and for extracting a WAV track from the source video before upload.
FFMPEG_PATH=ffmpeg

# --- Optional bonus: LLM re-ranking / human-readable reasons ---
# Leave OPENAI_API_KEY empty to skip this step entirely (default scoring
# reasons are generated locally from the signal breakdown instead).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
