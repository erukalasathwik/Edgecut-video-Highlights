{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://edgecut-highlights-vwjj.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://edgecut-highlights-vwjj.onrender.com/uploads/$1"
    }
  ]
}